{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "encrypted-email-website",
  "main": "src/worker.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}

